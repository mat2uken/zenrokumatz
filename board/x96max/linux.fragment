# RAM-root boot must not depend on architecture-default initrd settings.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_TMPFS=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MESON_GX=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SERIAL_MESON=y
CONFIG_SERIAL_MESON_CONSOLE=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_MESON_G12A=y
CONFIG_PHY_MESON_G12A_USB2=y
CONFIG_PHY_MESON_G12A_USB3_PCIE=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_MESON=y
CONFIG_MDIO_BUS_MUX_MESON_G12A=y
CONFIG_MESON_GXL_PHY=y
CONFIG_PWM_MESON=y

# The Amlogic VPU is not Verisilicon IP: hantro-vpu only matches Rockchip,
# i.MX, Sunxi and STM32 device nodes. Building it here just gives ffmpeg's
# h264_v4l2m2m a driver that binds to nothing on this SoC, which made an
# encoder run touch an unrelated register window and wedge the box. The real
# encoder is the amvenc_avc package.
# CONFIG_VIDEO_HANTRO is not set
