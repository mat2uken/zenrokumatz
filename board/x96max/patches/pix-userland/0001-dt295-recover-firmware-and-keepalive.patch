+/* Acknowledge every status bit and read the interrupt endpoint out, so the
+ * next command is not refused because an old event is still pending. */
+static int recover_events(dt295 *d) {
+    for (unsigned i = 0; i < 16; i++) {
+        uint16_t p, clear;
+        if (word(d, 0x90074, &p))
+            return -1;
+        clear = (uint16_t)(p & (uint16_t)(0x0100 | 0x0200 | 0x0400 | 0x0800));
+        if (p & 4)
+            clear |= 4;
+        if (!clear)
+            return 0;
+        if (putword(d, 0x90074, clear))
+            return -1;
+        if (notify(d, 10))
+            return -1;
+    }
+    return 0;
 }

+/* Read out what an earlier stream left queued on EP 0x81. It belongs to the
+ * previous session's transport key, so it can only be discarded. */
+static size_t recover_drain_ts(dt295 *d) {
+    uint8_t b[16384];
+    size_t total = 0;
+    while (total < DT295_DRAIN_LIMIT) {
+        size_t n = 0;
+        if (bulk_in(d, 0x81, b, sizeof(b), 10, &n) || !n)
+            break;
+        total += n;
+    }
+    return total;
+}
+
+/* Re-enable the command / status interrupts: the warm start skips the step the
+ * cold download does, and a run that died early may have left them off. */
+static int recover_irq_enable(dt295 *d) {
+    for (int b = 13; b >= 0; b--)
+        if (field(d, 0x90078, (unsigned)b, 1, b != 4))
+            return -1;
+    for (int b = 11; b >= 0; b--)
+        if (field(d, 0x901b4, (unsigned)b, 1, 1))
+            return -1;
+    return 0;
+}
+
+/* Bring a firmware that a previous run left running back to state 0x10.
+ * Command 3 is answered with 0x10 from every state the firmware can be left
+ * in; 0x11 and 0x12 additionally accept the suspend/resume pair (command 3
+ * and command 2/0 are refused from 0x11, verified on hardware). The image is
+ * never downloaded here: a download only works from state 0. */
+static int recover_soft_reset(dt295 *d, uint16_t from) {
+    fprintf(stderr, "{\"event\":\"dt295_recover\",\"from\":\"0x%04x\"}\n", (unsigned)from);
+    d->noack = 0;
+    if (recover_events(d))
+        return -1;
+    if (from == 0xffff || from == 1 || from == 2 || from == 3 || from == 4) {
+        size_t drained = recover_drain_ts(d);
+        if (drained)
+            fprintf(stderr, "{\"event\":\"dt295_recover_drain\",\"bytes\":%zu}\n", drained);
+    }
+    if (from == 0x11) {
+        /* From idle the previous session is still inside the firmware, and it
+         * dies at some point after the next one starts: that is how a stream
+         * stops on its own. Reload the idle image instead (the sequence the
+         * shutdown uses): the firmware then starts a fresh session. */
+        if (!command(d, 4, 0, 1, 0, NULL)) {
+            int uploaded = 1;
+            for (size_t off = 0; uploaded && off < d->assets->idle_n; off += 65536) {
+                size_t n = d->assets->idle_n - off;
+                if (n > 65536)
+                    n = 65536;
+                if (bulk_out(d, 0x02, d->assets->idle + off, n, 300))
+                    uploaded = 0;
+            }
+            if (uploaded && !command(d, 4, 1, 0, 0, NULL) && !wait_state(d, 0x10, 5000))
+                return 0;
+        }
+        /* Otherwise the suspend/resume pair, which command 3 also covers. */
+        (void)putword(d, 0x90074, 4);
+        if (!command(d, 2, 1, 0, 0, NULL) && !wait_state(d, 0x12, 1500)) {
+            (void)putword(d, 0x90074, 4);
+            if (!command(d, 2, 0, 0, 0, NULL) && !wait_state(d, 0x10, 3000))
+                return 0;
+        }
+    } else if (from == 0x12) {
+        if (!command(d, 2, 0, 0, 0, NULL) && !wait_state(d, 0x10, 3000))
+            return 0;
+    }
+    for (unsigned attempt = 0; attempt < 2; attempt++) {
+        if (attempt) {
+            (void)recover_events(d);
+            (void)putword(d, 0x90074, 4);
+        }
+        if (!command(d, 3, 0, 0, 0, NULL) && !wait_state(d, 0x10, 3000))
+            return 0;
+    }
+    fprintf(stderr, "{\"event\":\"dt295_recover_failed\",\"from\":\"0x%04x\",\"state\":\"0x%04x\"}\n",
+            (unsigned)from, (unsigned)dt295_state(d));
+    return -1;
+}
