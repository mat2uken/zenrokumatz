Diagnostic: report whether the glue node was found and whether
skip-glue-init was read, so the abort's origin can be identified
without a call trace.

--- a/drivers/usb/dwc3/dwc3-meson-g12a.c
+++ b/drivers/usb/dwc3/dwc3-meson-g12a.c
@@ -415,6 +415,9 @@
 	 * the GXL layout) is the first one reached. The PHYs are still set up by
 	 * their own driver through this node's phy list, as vendor firmware does.
 	 */
+	pr_err("DBG usb_init_glue node=%s skip=%d\n",
+	       priv->dev->of_node ? priv->dev->of_node->full_name : "(null)",
+	       of_property_read_bool(priv->dev->of_node, "amlogic,skip-glue-init"));
 	if (of_property_read_bool(priv->dev->of_node, "amlogic,skip-glue-init"))
 		return 0;
 
