# Unit 3: PIX-DT295 on GR terrestrial SBS. Runtime root is volatile RAM.
# SBS is the 5th remote-controller key but its physical channel is 17
# (service_id 35864, measured 2026-11-19); pix-ts takes physical channels
# 13..62, and ch5 fails the range check.
# The DT295 decrypts on its internal card slot, so no external B-CAS reader and
# no torne-b25 stage are used (PIX_DECRYPT=0). One tuner per unit: unit 1 keeps
# PX-S1UD/ch17 and unit 2 keeps DT295/BS11, so the same channel is not recorded twice.
PIX_TUNER=none
PIX_DECRYPT=0
PIX_SYSTEM=terrestrial
PIX_CHANNEL=17
# Leave PIX_SAT_SLOT and PIX_PIDS unset, do not set them empty: the launcher
# applies ${PIX_SAT_SLOT:=0} and a satellite PID list, which adds "--slot 0"
# to terrestrial capture and pix-ts rejects it (exit 2, usage).
PIX_DISPLAY=X96Max-P3
PIX_PORT=40774
PIX_ALLOWED_IP=192.168.99.80,192.168.99.52
PIX_SPOOL_MB=192
PIX_BITRATE=6000k
PIX_AUDIO_BITRATE=192k
PIX_GOP=60
PIX_DEINTERLACE=1
PIX_CAPTURE_SECONDS=1800
# Preserve CM feature sideband; analysis and final cuts remain NAS-owned.
# pix-stream-simple generates and forwards it (encode_with_features), so this
# is what makes CM chapters appear on this unit as they do on unit 2.
PIX_FEATURES=1
PIX_FEATURE_MAX_MB=384
PIX_FEATURE_STEP=3
PIX_FEATURE_FAILURES=3
PIX_LOGO_DIR=/var/lib/pix/logos
