// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
// Unit 3: drive the USB glue as GXL instead of G12A.
//
// The board's vendor device tree reports cpu-type = "gxl" on the dwc3 node, and
// vendor dmesg shows their USB2 PHY driver initialising 0xffe09000:
//
//   amlogic-new-usb2-v2 ffe09000.usb2phy: USB2 phy probe:phy_mem:0xffe09000
//
// In mainline the two driver variants interpret the glue base differently:
//
//   G12A: glue regmap = base + 0x80, and a u2p regmap per PHY at base + i*0x20
//   GXL : glue regmap = base,        and no u2p regmap at all
//
// With the G12A binding the driver writes 0xffe09000/0xffe09010 (u2p) and
// 0xffe09084 (USB_R1) and faults with a synchronous external abort, because on
// this board 0xffe09000 belongs to the USB2 PHY, not to the glue block.
// Selecting the GXL variant removes both the u2p registers and the 0x80 offset,
// which matches where the vendor blocks actually sit.
//
// gxl_drvdata asks for clocks named "usb_ctrl" and "ddr" (meson_gxl_clocks).
// Note num_clks is mistakenly ARRAY_SIZE(meson_g12a_clocks), so only the first
// entry, "usb_ctrl", is actually requested; supplying just that one is enough.
#include "meson-g12a-x96-max-p-ephy.dts"
#include <dt-bindings/clock/g12a-clkc.h>

&usb {
	compatible = "amlogic,meson-gxl-usb-ctrl";
	/*
	 * The G12A common dtsi gives the glue a single unnamed clock. GXL asks
	 * for it by name, so name it here.
	 */
	clocks = <&clkc CLKID_USB>;
	clock-names = "usb_ctrl";
	/*
	 * hcs_params1 reports MaxPorts = 3, but this board wires a fourth USB2
	 * port: PORTSC4 shows a connected device (CCS = 1, PP = 1) that never
	 * enumerates because the driver stops at port 3. The port register
	 * blocks are contiguous at a 0x10 stride, so one more is readable.
	 * Opt in to the xhci patch that raises the limit.
	 */
	amlogic,extra-usb-port;
};
