#!/bin/sh
#
# pix-logo-fetch - BS-15 のエンジニアリングサービス (929) から局ロゴを取り、
#                  /var/lib/pix/logos に置く。
#
# 局ロゴは各チャンネルの放送には入っておらず、BS-15 の 929 が全局分を
# 20 分ほどおきに 1 分弱だけ送出する。そのためこの箱では、録画中のチューナーを
# 一時的に借りる必要がある。録画が数十秒〜数分途切れるので、既定では実行せず
# --force を付けたときだけ動く。
#
#   pix-logo-fetch --force                 # 録画を止めて取りに行く
#   pix-logo-fetch --force --wait 600      # 送出待ちを長めに取る
#   pix-logo-fetch --dry-run               # 何をするかだけ表示する
#
# ロゴがそろえば待たずに終わり、パイプラインを再開する。取れなかったときは
# 終了コード 3 を返すので、日を置いて実行し直す。
set -u

LOG=${PIX_LOGO_LOG:-/tmp/pix-logo.log}
DEFAULTS=/etc/default/pix-stream-linux
INIT=${PIX_LOGO_INIT:-/etc/init.d/S97pix-stream}
STOPFILE=/var/run/pix-stream.stopped
LOGO_STOP=/var/run/pix-logo.stopped
ASSETS=/usr/share/pix-tuner
# 差し替えはテスト用 (scripts では既定のまま)
PARSER=${PIX_LOGO_PARSER:-/usr/bin/pix-dt295-logo}
CAPTURE=${PIX_LOGO_CAPTURE:-/usr/bin/pix-ts-legacy}
out=${PIX_LOGO_DIR:-/var/lib/pix/logos}
wait_seconds=180
force=0
dry_run=0

usage() {
    cat <<'TEXT'
usage: pix-logo-fetch [--force] [--dry-run] [--wait SEC] [--out DIR]

  --force       録画中のパイプラインを止めてチューナーを借りる (必須)
  --dry-run     実行せず、止める・録る・戻すの内容だけ表示する
  --wait SEC    送出を待つ上限 (既定 180)
  --out DIR     書き出す先 (既定 /var/lib/pix/logos)

終了コード: 0 取得または最新, 3 取得できず, 2 使い方/前提違い, 1 失敗
TEXT
}

while [ $# -gt 0 ]; do
    case "$1" in
        --force) force=1 ;;
        --dry-run) dry_run=1 ;;
        --wait) shift; wait_seconds=${1:-180} ;;
        --out) shift; out=${1:-/var/lib/pix/logos} ;;
        -h|--help) usage; exit 0 ;;
        *) echo "pix-logo-fetch: unknown option $1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') pix-logo-fetch: $*" | tee -a "$LOG" >&2; }

# Manual cancellation restores a borrowed tuner; service shutdown never does.
# restore_note には「何秒失ったか」を入れておく (中断時は空)。
restore_note=""
restore_pipeline() {
    # Every released borrowing owner inherits desired-running intent, even if
    # cancelled before pause. Only S97's desired-stop fence can revoke it.
    if [ -e "$STOPFILE" ]; then
        log 'stop requested; leaving the pipeline stopped'
        return 0
    fi
    log "restarting the pipeline${restore_note:+ ($restore_note)}"
    # resume checks the fence under S97's control lock; a shutdown racing
    # this check cannot be undone by restoration.
    if ! "$INIT" resume >>"$LOG" 2>&1; then
        [ -e "$STOPFILE" ] && return 0
        log "resume returned nonzero; verify recording before retrying $INIT start"
        return 1
    fi
}

[ -r "$DEFAULTS" ] && . "$DEFAULTS" 2>/dev/null || true
system=${PIX_SYSTEM:-bs}
channel=${PIX_SAT_CHANNEL:-15}
tsid=${PIX_SAT_TSID:-0x40f1}

if [ "$system" != "bs" ]; then
    log "system is $system; the logos are on BS-15. set PIX_SYSTEM=bs to use this"
    exit 2
fi
if [ "${PIX_TUNER:-}" != "dt295" ]; then
    log "PIX_TUNER is '${PIX_TUNER:-}' (not dt295); this box cannot tune BS-15 over the DT295 path"
    exit 2
fi
for binary in "$PARSER" "$CAPTURE"; do
    if [ ! -x "$binary" ]; then
        log "$binary is missing; install the pix-tuner build that has pix-dt295-logo"
        exit 2
    fi
done

if [ "$dry_run" = "0" ] && [ "$force" = "0" ]; then
    log "recording stops while the logos are fetched; rerun with --force"
    exit 2
fi

capture_cmd="$CAPTURE --model dt295 --assets $ASSETS -s bs -c $channel --tsid $tsid -t $wait_seconds"
parse_cmd="$PARSER --out $out --wait $wait_seconds --system bs --tsid $tsid"

if [ "$dry_run" = "1" ]; then
    echo "1. stop:    $INIT pause  (recording is interrupted)"
    echo "2. capture: $capture_cmd \\"
    echo "            | $parse_cmd"
    echo "3. restart: $INIT resume (unless service stop was requested)"
    exit 0
fi

if [ "$(id -u)" != "0" ]; then
    log "root only (it stops the recording pipeline)"
    exit 2
fi

# Serialize manual and scheduled fetches before either can stop recording.
fetch_lock=${PIX_LOGO_LOCK:-/var/run/pix-logo-fetch.lock}
# Prepare cleanup before acquiring ownership; no successful mkdir may be
# followed by a default TERM exit before cleanup has been installed.
# One EXIT trap owns capture teardown, lock release, then restoration.
# A parser exit must not leave a still-closing tuner behind.
pipeline=""
stop_capture() {
    [ -n "$pipeline" ] || return 0
    # Native capture handles INT; its forked TS/diagnostic writers ignore INT.
    # TERM would abort those helpers before the final END/ACK can be emitted.
    kill -INT -"$pipeline" 2>/dev/null || true
    kill -INT "$pipeline" 2>/dev/null || true
    waited=0
    while kill -0 -"$pipeline" 2>/dev/null || kill -0 "$pipeline" 2>/dev/null; do
        [ "$waited" -lt 35 ] || break
        sleep 1
        waited=$((waited + 1))
    done
    result=0
    if kill -0 -"$pipeline" 2>/dev/null || kill -0 "$pipeline" 2>/dev/null; then
        kill -KILL -"$pipeline" 2>/dev/null || true
        kill -KILL "$pipeline" 2>/dev/null || true
        result=1
        waited=0
        while kill -0 -"$pipeline" 2>/dev/null || kill -0 "$pipeline" 2>/dev/null; do
            [ "$waited" -lt 5 ] || break
            sleep 1
            waited=$((waited + 1))
        done
    fi
    if kill -0 -"$pipeline" 2>/dev/null || kill -0 "$pipeline" 2>/dev/null; then
        return 1
    fi
    wait "$pipeline" 2>/dev/null || true
    pipeline=""
    return "$result"
}
release() {
    status=$?
    trap - EXIT
    # Catch rather than ignore: ignored dispositions survive exec and would
    # make the resumed init/service inherit an uncatchable ignored TERM.
    trap ':' INT TERM
    if stop_capture; then
        # Once the capture is completely gone, release borrowing exclusion
        # before resume. Ordinary starts need no exception to that exclusion.
        if rm -f "$fetch_lock/pid" && rmdir "$fetch_lock" 2>/dev/null; then
            restore_pipeline || status=1
        else
            status=1
        fi
    else
        # Fail closed, not a late recorder restart over a live capture.
        log 'capture teardown failed; keeping fetch lock and pipeline stopped'
        status=1
    fi
    exit "$status"
}
# Defer cancellation only across acquisition and PID publication. Busy/dry-run
# callers never install the EXIT owner trap and cannot release another owner.
cancelled=0
trap 'cancelled=1' INT TERM
# A group-delivered signal must not kill mkdir after it created the directory
# but before reporting success. Ignore only in this acquisition-only child.
if ! (trap '' INT TERM; mkdir "$fetch_lock" 2>/dev/null); then
    log "logo fetch lock is busy; recording was not interrupted"
    exit 1
fi
trap release EXIT
# S98 also cancels manual CLI fetches, which are not children of weekly.
echo "$$" > "$fetch_lock/pid" || exit 1
trap 'exit 143' INT TERM
[ "$cancelled" = 0 ] || exit 143
mkdir -p "$out" /dev/shm/pix
if [ -e "$STOPFILE" ] || [ -e "$LOGO_STOP" ]; then
    log 'service stop requested; tuner was not borrowed'
    exit 1
fi
log "stopping the pipeline (recording is interrupted for up to ${wait_seconds}s)"
# A preceding fetch may have released its lock but not resumed yet. Always
# acquire a successful pause, without inferring intent from transient PIDs.
if ! "$INIT" pause >/dev/null 2>&1; then
    log "pipeline stop failed; tuner was not borrowed"
    exit 1
fi
# The tuner is only free once the capture process is gone: its lock would
# otherwise make the new capture fail with "recording lock is busy".
waited=0
while ps | grep -q "[p]ix-ts-legacy" && [ "$waited" -lt 15 ]; do
    sleep 1
    waited=$((waited + 1))
done
if ps | grep -q "[p]ix-ts-legacy"; then
    log "capture did not stop; tuner was not borrowed"
    exit 1
fi
# The capture binary owns its fcntl lock. Never unlink its inode, even when
# the file remains after an earlier process exited: fcntl releases on close.

if [ -e "$STOPFILE" ] || [ -e "$LOGO_STOP" ]; then
    log 'service stop requested; capture cancelled'
    exit 1
fi
started=$(date +%s)
log "capturing BS-15 (929), waiting up to ${wait_seconds}s"
# Its own process group lets INT request native teardown without aborting
# the capture's TS/diagnostic writers. EXIT drains before giving recording back.
# shellcheck disable=SC2086
setsid sh -c "trap ':' INT TERM; $capture_cmd 2>>'$LOG' | $parse_cmd 2>>'$LOG'; status=\$?; wait; exit \"\$status\"" &
pipeline=$!
wait "$pipeline"
status=$?
elapsed=$(( $(date +%s) - started ))

restore_note="${elapsed}s of recording lost"
# EXIT drains and reaps the capture group before considering restoration.

case "$status" in
    0) log "logos stored in $out" ;;
    3) log "no complete logo data in ${elapsed}s; try again another day" ;;
    *) log "logo extraction failed (exit $status)" ;;
esac
exit "$status"
