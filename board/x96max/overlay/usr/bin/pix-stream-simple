#!/bin/sh
#
# pix-stream-simple - チューナーから受けて変換し、stb_streamer へ流し続ける
#
# 経路は2通り。
#
#   クリア出力のチューナー（PIX-DT295）:
#     tuner | 変換 | fMP4 | stb_streamer   を直結する。中間ファイルは作らない
#
#   復号が要るチューナー（PIX_DECRYPT=1、現在は未使用）:
#     tuner | torne-b25 > /dev/shm/pix/live.ts と書き出し、別プロセスが
#     tail -f で読む。復号器は出力が詰まるとカードのやり取りごと止まるため
#     直結できないが、必要なら数十秒分（64MB程度）で足りる。
#
exec >>/tmp/pix-simple.log 2>&1
. /etc/default/pix-stream-linux 2>/dev/null || true
. /usr/bin/pix-usb-reset-common || exit 1
: "${PIX_BITRATE:=6000k}"
: "${PIX_GOP:=60}"
: "${PIX_PORT:=40774}"
: "${PIX_ALLOWED_IP:=192.168.99.80}"
: "${PIX_SPOOL_MB:=192}"
: "${PIX_DISPLAY:=X96Max}"
: "${PIX_CAPTURE_SECONDS:=1800}"
: "${PIX_LIVE_FILE:=/dev/shm/pix/live.ts}"
: "${PIX_RING_FILE:=/dev/shm/pix/live.ring}"
: "${PIX_RING_MB:=32}"
: "${PIX_LIVE_MAX_MB:=64}"
: "${PIX_DECRYPT:=0}"
: "${PIX_TUNER:=dt295}"
: "${PIX_SYSTEM:=bs}"
: "${PIX_CHANNEL:=9}"
# Satellite-only options default to none: a terrestrial unit with these set
# would otherwise pass "--slot 0" and a BS/CS PID list, which pix-ts rejects
# for terrestrial capture (exit 2, usage). Set them per unit in
# /etc/default/pix-stream-linux when the unit really receives BS/CS.
: "${PIX_SAT_SLOT:=}"
: "${PIX_PIDS:=}"
: "${PIX_LOGO_DIR:=/var/lib/pix/logos}"

log() { echo "$(date +%H:%M:%S) simple: $*"; }

extra=""
[ -n "$PIX_SAT_SLOT" ] && extra="$extra --slot $PIX_SAT_SLOT"
for pid in $PIX_PIDS; do extra="$extra -p $pid"; done

# Each probe/pipeline gets a private session. The supervisor never signals by
# command name (pipeline function shells also share our name).
OWNER=/var/run/pix-stream.owner
STOPFILE=/var/run/pix-stream.stopped
worker=""
retry_sleep=""
cleanup_failed=0
cleanup_children() {
    # An exit taken inside a trapped command (run_worker's wait, a pipeline)
    # never assigns the PID to the variable. The worker records its own PID, so
    # ownership can still be cleaned instead of being retained forever.
    [ -n "$worker" ] || worker=$(cat "$OWNER/worker."*/worker 2>/dev/null)
    case "$worker" in ''|*[!0-9]*|0|1) worker=""; return 0 ;; esac
    # The worker stops native capture first; downstream readers stay alive
    # until the native parent has exited and published its real wait status.
    [ "${1:-}" = reaped ] || kill -TERM "$worker" 2>/dev/null || true
    waited=0
    while kill -0 -"$worker" 2>/dev/null || kill -0 "$worker" 2>/dev/null; do
        [ "$waited" -lt 35 ] || break
        sleep 1
        waited=$((waited + 1))
    done
    result=0
    forced=0
    if kill -0 -"$worker" 2>/dev/null || kill -0 "$worker" 2>/dev/null; then
        forced=1
        log "owned pipeline exceeded 35s TERM budget; forcing shutdown"
        kill -KILL -"$worker" 2>/dev/null || true
        kill -KILL "$worker" 2>/dev/null || true
        result=1
        waited=0
        while kill -0 -"$worker" 2>/dev/null || kill -0 "$worker" 2>/dev/null; do
            [ "$waited" -lt 5 ] || break
            sleep 1
            waited=$((waited + 1))
        done
    fi
    # Never enter an unbounded wait on an uninterruptible child.
    if kill -0 -"$worker" 2>/dev/null || kill -0 "$worker" 2>/dev/null; then
        cleanup_failed=1
        return 1
    fi
    [ "${1:-}" = reaped ] || wait "$worker" 2>/dev/null || true
    workdir="$OWNER/worker.$worker"
    if [ -d "$workdir" ]; then
        if read_native_exit "$workdir"; then
            log "native capture exit=$native_rc (process drain is separate from clean capture)"
        elif [ "$forced" = 0 ] && [ -s "$workdir/pid" ]; then
            # The native process was started but its real exit is unknown: the
            # tuner may still be busy, so ownership must stay.
            log 'native exit acknowledgement missing or invalid; retaining ownership'
            result=1
        else
            # Terminated before native was started, or force-killed: no tuner
            # was handed over, so the dead worker's metadata is only stale.
            log 'worker ended before native capture was established; clearing metadata'
            # Leftover metadata is a known trace, not a reason to keep the whole
            # service unusable: no tuner was handed over on this path.
            rm -f "$workdir/pid" "$workdir/exit" "$workdir/worker" 2>/dev/null
            rmdir "$workdir" 2>/dev/null || log "stale worker metadata left in $workdir"
            result=0
        fi
        if [ "$result" = 0 ] && [ -d "$workdir" ]; then
            rm -f "$workdir/pid" "$workdir/exit" "$workdir/worker" 2>/dev/null
            rmdir "$workdir" 2>/dev/null || log "worker metadata remains in $workdir"
        fi
    fi
    worker=""
    [ "$result" = 0 ] || cleanup_failed=1
    return "$result"
}

run_worker() {
    [ ! -e "$STOPFILE" ] || return 1
    # Publish the owned PID before cancellation can enter finish().
    cancelled=0
    trap 'cancelled=1' INT TERM
    setsid "$0" --worker "$1" &
    worker=$!
    trap 'exit 143' INT TERM
    [ "$cancelled" = 0 ] || exit 143
    wait "$worker"
    worker_status=$?
    cleanup_children reaped || return 1
    return "$worker_status"
}

pause_retry() {
    [ ! -e "$STOPFILE" ] || return 1
    sleep "$1" &
    retry_sleep=$!
    wait "$retry_sleep"
    retry_sleep=""
}

finish() {
    status=$?
    trap - EXIT
    trap '' INT TERM
    if [ -n "$retry_sleep" ]; then
        kill -TERM "$retry_sleep" 2>/dev/null || true
        wait "$retry_sleep" 2>/dev/null || true
    fi
    cleanup_children || status=1
    if [ "$cleanup_failed" = 0 ]; then
        rm -f "$OWNER/pid"
        rmdir "$OWNER" || status=1
    else
        log "teardown failed; retaining ownership to prevent another capture"
        status=1
    fi
    exit "$status"
}

read_native_exit() {
    native_rc=$(cat "$1/exit" 2>/dev/null)
    case "$native_rc" in ''|*[!0-9]*) return 1;; esac
    [ "$native_rc" -le 255 ]
}

# The anonymous pipeline's first stage owns/reaps native, not its writer children.
capture() {
    # No inherited caught trap may interrupt wait and publish a false ACK.
    trap - EXIT INT TERM
    "$@" &
    native=$!
    if ! echo "$native" > "$WORK/pid"; then
        kill -TERM "$native" 2>/dev/null || true
        wait "$native" 2>/dev/null
        return 1
    fi
    wait "$native"
    native_status=$?
    echo "$native_status" > "$WORK/exit" || return 1
    return "$native_status"
}

worker_finish() {
    role_status=$?
    trap - EXIT
    trap ':' INT TERM
    while [ ! -s "$WORK/pid" ]; do
        kill -0 "$role_pid" 2>/dev/null || exit 1
        sleep 0.1
    done
    native=$(cat "$WORK/pid")
    case "$native" in ''|*[!0-9]*|0|1) exit 1;; esac
    [ -s "$WORK/exit" ] || kill -TERM "$native" 2>/dev/null || true
    # Only the outer supervisor owns the 35+5s deadline and forced group kill.
    while [ ! -s "$WORK/exit" ]; do sleep 0.1; done
    read_native_exit "$WORK" || exit 1
    kill -TERM -"$$" 2>/dev/null || true
    wait "$role_pid" 2>/dev/null || true
    exit "$role_status"
}

encode() {
    # bwdif（インタレース解除）とscaleを同時に掛けると実時間を割り込む
    # （実測0.65x）。片方だけなら1.2x出る。画質を優先してデインタレースだけを
    # 掛け、解像度は元の1920x1080のまま出す。縞の残る絵をprogressiveとして
    # 符号化するのは避けたい。
    exec ffmpeg -hide_banner -nostdin -v info -nostats -probesize 2000000 -analyzeduration 3000000 \
        -f mpegts -i pipe:0 \
        -c:v mpeg2_v4l2m2m -vf "bwdif=mode=send_frame,format=nv12" \
        -c:v h264_v4l2m2m -num_capture_buffers 32 -b:v "$PIX_BITRATE" -g "$PIX_GOP" \
        -map 0:v:0 -map 0:a:0 -c:a copy -copyts -start_at_zero -f mpegts pipe:1 \
        2>/tmp/pix-ff1.log
}

fragment() {
    # 音声はそのまま写す。AACを符号化し直すと実時間を割り込む（実測0.96x）。
    # 写すだけなら1.19x出るので、こちらを既定にする。
    exec ffmpeg -hide_banner -nostdin -v info -nostats -probesize 2000000 -analyzeduration 3000000 \
        -f mpegts -i pipe:0 -map 0:v -map 0:a -c copy -bsf:a aac_adtstoasc \
        -movflags +frag_keyframe+empty_moov+default_base_moof -f mp4 pipe:1 2>/tmp/pix-ff2.log
}


streamer() {
    exec stb_streamer --port "$PIX_PORT" --allowed-ip "$PIX_ALLOWED_IP" \
        --spool-mb "$PIX_SPOOL_MB" --channel "$PIX_CHANNEL" --display "$PIX_DISPLAY" \
        --program-file /dev/shm/pix/program.txt --logo-dir "$PIX_LOGO_DIR" \
        2>/tmp/pix-stb.log
}

# クリアTSを出すチューナーは直結する。中間ファイルを作らないので、
# ディスクもRAMも消費せず、番組の途中で切れることもない。
run_direct() {
    # shellcheck disable=SC2086
    capture pix-ts-legacy --model "$PIX_TUNER" --assets /usr/share/pix-tuner \
        -s "$PIX_SYSTEM" -c "$PIX_CHANNEL" $extra -t "$PIX_CAPTURE_SECONDS" \
        2>/tmp/pix-ts.log \
      | eit_watch --state /dev/shm/pix/program.txt --logo-dir "$PIX_LOGO_DIR" \
            2>/tmp/pix-eit.log \
      | encode | fragment | streamer
}

# 復号器を挟むときは、出力の詰まりでカードのやり取りが止まるため、
# いったんファイルへ書いて別プロセスに読ませる。
run_buffered() {
    rm -f /dev/shm/pix/b25.trace "$PIX_RING_FILE"
    # 復号器の出力は固定長のリングへ入れる。追記型のファイルに書くと
    # 録画の長さだけ育って tmpfs を埋めるが、リングなら一定量で回る。
    # shellcheck disable=SC2086
    capture pix-ts-legacy --model "$PIX_TUNER" --assets /usr/share/pix-tuner \
        -s "$PIX_SYSTEM" -c "$PIX_CHANNEL" $extra -t "$PIX_CAPTURE_SECONDS" \
        2>/tmp/pix-ts.log \
      | torne-b25 --card-socket /dev/shm/torne/card.sock --trace /dev/shm/pix/b25.trace \
            2>/tmp/pix-b25.log \
      | pix-ring --path "$PIX_RING_FILE" --size "$PIX_RING_MB" --produce \
            2>/tmp/pix-ring.log &
    producer=$!
    waited=0
    while [ "$waited" -lt 240 ]; do
        [ -s "$PIX_RING_FILE" ] && break
        state=$(awk '{print $3}' "/proc/$producer/stat" 2>/dev/null)
        [ -z "$state" ] && break
        [ "$state" = "Z" ] && break
        sleep 0.5
        waited=$((waited + 1))
    done
    if [ ! -s "$PIX_RING_FILE" ]; then
        log "no decrypted data; restarting"
        kill -TERM "$producer" 2>/dev/null
        return 1
    fi
    pix-ring --path "$PIX_RING_FILE" --size "$PIX_RING_MB" --consume \
        2>>/tmp/pix-ring.log | encode | fragment | streamer &
    reader=$!
    while :; do
        state=$(awk '{print $3}' "/proc/$producer/stat" 2>/dev/null)
        [ -z "$state" ] && break
        [ "$state" = "Z" ] && break
        sleep 5
    done
    kill -TERM "$producer" "$reader" 2>/dev/null
    wait "$producer" 2>/dev/null
    wait "$reader" 2>/dev/null
    rm -f "$PIX_RING_FILE"
}

# DT295 は強制終了や電源断のあとファームウェアが state 2 / 0xffff に残り、
# 「firmware boot requires cold state 0 or unauthenticated state 16」で
# 起動できなくなる。安全確認付きの unbind/bind で controller/PHY を
# 再初期化する（VBUS の電源断やコールドブートは保証しない）。
dt295_recover() {
    log "dt295: attempting guarded USB controller recovery"
    cleanup_children || return 1
    [ ! -e "$STOPFILE" ] || return 1
    # The capture binary owns its fcntl lock inode. Never unlink that file.
    if ! pix_usb_reset; then
        log "dt295: recovery refused or failed; stopping (manual intervention required)"
        return 1
    fi
    log "dt295: re-enumerated"
}

fast_fail=0

# 放送休止（空PAT）では番組が1つも乗らない。始めても黒画面を NAS に
# 送るだけなので、開始前に短く確かめて待つ。
broadcast_ready() {
    # shellcheck disable=SC2086
    bytes=$(capture pix-ts-legacy --model "$PIX_TUNER" --assets /usr/share/pix-tuner \
        -s "$PIX_SYSTEM" -c "$PIX_CHANNEL" $extra -t 6 2>/tmp/pix-tsprobe.log \
        | encode | wc -c)
    # PAT が取れていて番組が0件なら放送休止。ロック前（have_pat 0）は
    # 休止と決めつけず、そのまま開始する。
    if grep -q '"have_pat":1' /tmp/pix-tsprobe.log 2>/dev/null &&
       grep -q '"program_count":0' /tmp/pix-tsprobe.log 2>/dev/null; then
        return 1
    fi
    # No output without a confirmed empty PAT may be firmware failure, not a
    # static picture. Let the normal pipeline expose its error and recover.
    [ "$bytes" -eq 0 ] && return 0
    # カラーバーなどの静止画は符号化後のレートが極端に低い（実測: 静止区間
    # 237 kbps、通常番組 4〜6 Mbps）。6秒の平均で判断する。
    kbps=$((bytes * 8 / 6 / 1000))
    if [ "$kbps" -lt 300 ]; then
        log "static picture (${kbps} kbps); treating as broadcast suspension"
        return 1
    fi
    return 0
}

# Internal workers reuse the existing media paths, but never acquire supervisor
# ownership or retry. Caught signals reset to default in exec'd media children.
if [ "${1:-}" = --worker ]; then
    WORK="$OWNER/worker.$$"
    cancelled=0
    trap 'cancelled=1' INT TERM
    mkdir "$WORK" || exit 1
    # Written only after the directory exists: the outer cleanup uses this
    # file to find a worker it could not see through its own exit path.
    if ! echo "$$" > "$WORK/worker"; then
        rmdir "$WORK"
        exit 1
    fi
    trap worker_finish EXIT
    # A foreground pipeline defers TERM traps. The builtin wait is interruptible.
    (
        trap - EXIT INT TERM
        case "${2:-}" in
            probe) broadcast_ready ;;
            direct) run_direct ;;
            buffered) run_buffered ;;
            *) exit 2 ;;
        esac
    ) &
    role_pid=$!
    trap 'exit 0' INT TERM
    [ "$cancelled" = 0 ] || exit 0
    wait "$role_pid"
    exit $?
fi

[ ! -e "$STOPFILE" ] || exit 1
if ! mkdir "$OWNER" 2>/dev/null; then
    log "another supervisor owns the pipeline (or a failed teardown needs attention)"
    exit 1
fi
trap finish EXIT
trap 'exit 143' INT TERM
echo "$$" > "$OWNER/pid" || exit 1

# Wait for the tuner to appear before starting the pipeline.
#
# On this board the DT295 can take a while to enumerate after boot. Starting
# straight away made the pipeline fail three times in a row, which triggered
# dt295_recover -> pix_usb_reset and left the box unresponsive. Waiting (bounded)
# for the device to show up avoids that entirely.
#
# The check reads sysfs, because the tuner IDs are the same ones the capture
# binary matches on (vendor 0x06b8, DT295 product 0x103b).
wait_for_tuner() {
    [ "$PIX_DECRYPT" = "1" ] && return 0
    # Unset waits until the tuner appears or a stop is requested, because
    # proceeding without one fails the pipeline three times in a row and that
    # reaches dt295_recover -> pix_usb_reset, which left the board unresponsive.
    # A positive PIX_TUNER_WAIT bounds the wait and then continues anyway; that
    # is for tests and for deliberate one-off diagnostics.
    wanted=${PIX_TUNER_WAIT:-}
    case "$wanted" in ''|*[!0-9]*) wanted=0 ;; esac
    i=0
    while :; do
        [ ! -e "$STOPFILE" ] || return 1
        for dev in /sys/bus/usb/devices/*/; do
            [ -r "$dev/idVendor" ] || continue
            read -r vid < "$dev/idVendor" 2>/dev/null || continue
            [ "$vid" = "06b8" ] || continue
            read -r pid < "$dev/idProduct" 2>/dev/null || continue
            [ "$pid" = "103b" ] || continue
            [ "$i" -gt 0 ] && log "tuner: appeared after ${i}s"
            return 0
        done
        if [ "$wanted" -gt 0 ] && [ "$i" -ge "$wanted" ]; then
            log "tuner: not found within ${wanted}s; starting anyway"
            return 0
        fi
        # Report once a minute so a missing tuner is visible without flooding.
        if [ "$i" -gt 0 ] && [ $((i % 60)) -eq 0 ]; then
            log "tuner: still waiting (${i}s)"
        fi
        sleep 1
        i=$((i + 1))
    done
}

while [ ! -e "$STOPFILE" ]; do
    wait_for_tuner || break
    if [ "$PIX_DECRYPT" != "1" ] && ! run_worker probe; then
        [ "$cleanup_failed" = 0 ] || exit 1
        [ ! -e "$STOPFILE" ] || break
        log "no programme on air (broadcast suspension); waiting 5 minutes"
        pause_retry 300
        continue
    fi
    started=$(date +%s)
    log "starting"
    if [ "$PIX_DECRYPT" = "1" ]; then
        run_worker buffered
    else
        rm -f "$PIX_LIVE_FILE"
        run_worker direct
    fi
    [ "$cleanup_failed" = 0 ] || exit 1
    [ ! -e "$STOPFILE" ] || break
    ran=$(( $(date +%s) - started ))
    log "pipeline stopped after ${ran}s; restarting"
    if [ "$PIX_DECRYPT" != "1" ] && [ "$ran" -lt 10 ]; then
        fast_fail=$((fast_fail + 1))
    else
        fast_fail=0
    fi
    # パッチを当てた個体はまずソフトリセットで戻る。それでも駄目だったときだけ
    # ここ (USB の切り直し) に来る。
    if [ "$PIX_DECRYPT" != "1" ] && grep -qE "requires cold state|cannot read DT295 firmware state|firmware could not be reset" /tmp/pix-ts.log 2>/dev/null; then
        dt295_recover || exit 1
        fast_fail=0
    elif [ "$PIX_DECRYPT" != "1" ] && [ "$fast_fail" -ge 3 ]; then
        log "dt295: three quick failures in a row"
        dt295_recover || exit 1
        fast_fail=0
    fi
    pause_retry 2
done
