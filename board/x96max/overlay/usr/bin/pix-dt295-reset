#!/bin/sh
# pix-dt295-reset - DT295 を物理的に抜き差しせずにコールドブートさせる。
#
# DT295 は強制終了や電源断のあと、ファームウェアが state 2 / 0xffff に
# 残ることがある。pix-ts-legacy はパッチでソフトリセット (コマンド3、0x11 は
# サスペンド→レジューム) を先に試すので、通常はこちらは要らない。
# それでも「firmware could not be reset; a cold power cycle is required」で
# 失敗する個体向けの最後の手段。USB ポートの disable/enable では VBUS が
# 切れないため復旧しないが、xhci のグルードライバ (dwc3-meson-g12a) を
# unbind/bind すると vbus-supply が落ちてデバイスがコールドブートする。
#
# 実行すると録画は数十秒止まる。パイプラインを止めてから切り替える。
set -u

. /usr/bin/pix-usb-reset-common || exit 1

if [ "$(id -u)" != "0" ]; then
    echo "pix-dt295-reset: root only" >&2
    exit 1
fi

stop_pipeline() {
    echo "pix-dt295-reset: stopping the pipeline"
    /etc/init.d/S97pix-stream stop >/dev/null 2>&1 || true
    for i in 1 2 3; do
        for p in $(ps | grep -E "[p]ix-stream-simple|[p]ix-producer|[p]ix-reader|[e]it_watch|[s]tb_streamer|[f]fmpeg|[t]ail -f -c|[p]ix-ts-legacy" | awk '{print $1}'); do
            kill -TERM "$p" 2>/dev/null || true
        done
        sleep 2
    done
    for p in $(ps | grep -E "[p]ix-stream-simple|[p]ix-producer|[p]ix-reader|[e]it_watch|[s]tb_streamer|[f]fmpeg|[t]ail -f -c|[p]ix-ts-legacy" | awk '{print $1}'); do
        kill -9 "$p" 2>/dev/null || true
    done
    rm -f /var/run/pix-stream.pid /tmp/pix-userland-dt295-0.lock
}

# Preflight (including the shared reset budget) precedes pipeline interruption.
# The helper checks again after stop_pipeline and immediately before unbind.
pix_usb_reset stop_pipeline || exit 1

echo "pix-dt295-reset: starting the pipeline"
/etc/init.d/S97pix-stream start
