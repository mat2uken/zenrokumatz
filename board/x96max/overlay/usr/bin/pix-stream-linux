#!/bin/sh
#
# pix-stream-linux - 実放送を H.264/AAC の fMP4 にして dtv_android と同じ HTTP で配信する
#
#   siano-ts --device BUS:ADDR -c CHANNEL     PX-S1UD で選局して TS を出す
#     | torne-b25 --card-socket ...           B-CAS でスクランブルを解除する
#     | eit_watch                             EIT から現在の番組を書き出す
#     | ffmpeg (1 段目)                       HW デコード -> デインターレース -> HW エンコード
#     | ffmpeg (2 段目)                       fMP4 へ再多重化
#     | stb_streamer                          RamSpool + HTTP で NAS に配信
#
# 1 段目と 2 段目を分けるのは h264_v4l2m2m が extradata を出さないため。
# 1 本のパイプで fMP4 を直接吐くと、moov を先に書く関係で avcC が空になり
# 再生できない。2 段目が SPS/PPS を解析して正しい avcC を書く。
#
# 端末のストレージには書かない。TS も映像もメモリ上だけで扱う。
#
. /etc/default/pix-stream-linux 2>/dev/null || true

: "${PIX_CHANNEL:=20}"
: "${PIX_TUNER:=pxs1ud}"
: "${PIX_TUNER_DEV:=}"
: "${PIX_DT295_ASSETS:=/usr/share/pix-tuner}"
: "${PIX_SYSTEM:=terrestrial}"
: "${PIX_SAT_SLOT:=}"
: "${PIX_SAT_TSID:=}"
: "${PIX_DT295_DESCRAMBLED:=0}"
: "${PIX_PIDS:=}"
: "${PIX_SKIP_PACKETS:=0}"
: "${PIX_LIVE_FILE:=/dev/shm/pix/live.ts}"
: "${PIX_LIVE_MAX_MB:=256}"
: "${PIX_LIVE_TRIES:=5}"
: "${PIX_FIRMWARE:=/lib/firmware/isdbt_rio.inp}"
: "${PIX_CARD_SOCKET:=/dev/shm/torne/card.sock}"
: "${PIX_PORT:=40774}"
: "${PIX_ALLOWED_IP:=192.168.99.80,192.168.99.52}"
: "${PIX_SPOOL_MB:=192}"
: "${PIX_BITRATE:=6000k}"
: "${PIX_AUDIO_BITRATE:=192k}"
: "${PIX_GOP:=60}"
: "${PIX_DEINTERLACE:=1}"
: "${PIX_START_DELAY:=4}"
: "${PIX_DISPLAY:=X96Max-P}"
: "${PIX_LOG_DIR:=/tmp}"
: "${PIX_FEATURES:=0}"
: "${PIX_FEATURE_MAX_MB:=384}"
# 解析するフレームの間隔。3なら3フレームに1回。全フレーム解析はHWデコーダーを
# 詰まらせるため間引く。fps指定と違い元のPTSを保つのでNAS側で対応付けできる。
: "${PIX_FEATURE_STEP:=1}"
# 解析基準の解像度。統計はこの縮小画像で取るので、フル解像度より大幅に軽い。
: "${PIX_FEATURE_SIZE:=320x180}"
# 連続失敗の上限。超えたら解析を切って素のパイプラインへ戻す。
: "${PIX_FEATURE_FAILURES:=3}"

log() { echo "pix-stream: $*" >&2; }

# 端末のバス:アドレスは再起動で変わるので、指定が無ければ一覧から拾う
detect_tuner() {
    siano-ts --list 2>/dev/null | sed -n 's/.*bus=\([0-9]*\) address=\([0-9]*\).*/\1:\2/p' | head -1
}

kill_stale() {
    # The DT295 parks itself on SIGTERM and only then can the next capture open
    # it again. A SIGKILL leaves the firmware in a state it refuses to boot
    # from, so try the polite signal first and force only what survives.
    for p in $(ps | grep -E "[s]iano-ts|[t]orne-c|[t]orne-b25|[p]ix-ts-legacy|[f]fmpeg|[s]tb_streamer|[t]ail -f" | awk '{print $1}'); do
        kill -TERM "$p" 2>/dev/null
    done
    sleep 3
    for p in $(ps | grep -E "[s]iano-ts|[t]orne-c|[t]orne-b25|[p]ix-ts-legacy|[f]fmpeg|[s]tb_streamer|[t]ail -f" | awk '{print $1}'); do
        kill -9 "$p" 2>/dev/null
    done
    # Wait until the processes are really gone. Starting a new tuner while the
    # old one still holds the USB device gives a reader that sees no data, and
    # the failure then looks like a card or stream problem.
    waited=0
    while [ "$waited" -lt 20 ]; do
        left=$(ps | grep -cE "[s]iano-ts|[t]orne-c|[t]orne-b25|[p]ix-ts-legacy|[f]fmpeg|[s]tb_streamer")
        [ "$left" -eq 0 ] && break
        sleep 0.5
        waited=$((waited + 1))
    done
    log "stale stages cleared after ${waited} waits (left=${left:-0})"
    sleep 2
}

cleanup() {
    g_stop=1
    # A launcher that refused to start must not touch the one that is running.
    if [ "$g_owner" != "1" ]; then
        log "stopped (not the owner; leaving the pipeline alone)"
        return
    fi
    kill_stale
    rm -f /dev/shm/pix/*.fifo 2>/dev/null
    # Only the process that owns the lock may release it.
    if [ "$$" = "$(cat /dev/shm/pix/launcher.lock 2>/dev/null)" ]; then
        rm -f /dev/shm/pix/launcher.lock
    fi
    log "stopped"
}
g_owner=0
trap cleanup EXIT INT TERM

# One launcher only. A second copy would fight the first for the tuner and the
# HTTP port, and the loser would leave the tuner holding a receiver slot.
mkdir -p /dev/shm/pix
LOCK=/dev/shm/pix/launcher.lock
if [ -f "$LOCK" ]; then
    holder=$(cat "$LOCK" 2>/dev/null)
    # BusyBox has no pgrep; ps is what the rest of this script already uses.
    if [ -n "$holder" ] && ps | awk '{print $1}' | grep -qx "$holder"; then
        log "already running as $holder; not starting a second launcher"
        exit 0
    fi
    log "removing a stale launcher lock ($holder)"
fi
echo "$$" > "$LOCK"
g_owner=1

kill_stale

DEV="${PIX_TUNER_DEV:-}"
case "$PIX_TUNER" in
    pxs1ud|*)
        [ -n "$DEV" ] || DEV="$(detect_tuner)"
        ;;
esac
if [ "$PIX_TUNER" = "pxs1ud" ] && [ -z "$DEV" ]; then
    log "PX-S1UD が見つかりません (siano-ts --list が空)"
    exit 1
fi

# The PX-S1UD needs its firmware file; the other two carry theirs differently.
if [ "$PIX_TUNER" = "pxs1ud" ] && [ ! -r "$PIX_FIRMWARE" ]; then
    log "ファームウェアがありません: $PIX_FIRMWARE"
    exit 1
fi
if [ "$PIX_TUNER" = "dt295" ] && [ ! -r "$PIX_DT295_ASSETS" ]; then
    log "DT295のアセットがありません: $PIX_DT295_ASSETS"
    exit 1
fi

# DT295 descrambles inside the tuner path, so it needs no card socket.
if [ "$PIX_TUNER" != "dt295" ] && [ ! -S "$PIX_CARD_SOCKET" ]; then
    log "カードソケットがありません: $PIX_CARD_SOCKET (S96bcas を先に起動してください)"
    exit 1
fi

if [ "$PIX_DEINTERLACE" = "1" ]; then
    VF="bwdif=mode=send_frame,format=nv12"
else
    VF="format=nv12"
fi

# The NAS keeps its CM markers per frame size, and the BS11 marker was learned
# at 1440x1080 (the same size the first unit produces). Satellite is captured
# at 1920x1080, so scale it to that size or the marker never matches and the
# detector falls back to the weaker timing-only path.
if [ "$PIX_TUNER" = "dt295" ]; then
    VF="$VF,scale=1440:1080,setsar=4/3"
fi

# CM特徴量。NASがfeatures=v1を要求した時だけstb_streamerがpixfを差し込む。
# 映像は既存のデコード結果から測るので、追加の映像デコードは行わない。
FEAT_AUX_OUT=""
FEAT_AUDIO_OUT=""
FEAT_ARGS=""
VIDEO_IN="-vf $VF"
if [ "$PIX_FEATURES" = "1" ]; then
    mkdir -p /dev/shm/pix
    # Analyse a 320x180 copy. Running signalstats on the full 1440x1080 frames
    # cost 84 s for 39.5 s of video; on the small copy it is 30 s. The CM rules
    # only need frame statistics, not full resolution.
    analyze="scale=320:180,signalstats,blackdetect=d=0.1:pix_th=0.125:pic_th=0.98"
    # The scene score is the mean absolute difference from the previous frame
    # (signalstats YDIF). It matches what cm-scan measures, so the same
    # threshold means the same thing on both sides; scdet did not.
    analyze="$analyze,metadata=mode=print:key=lavfi.signalstats.YAVG"
    analyze="$analyze,metadata=mode=print:key=lavfi.signalstats.YDIF"
    # The picture and the sound must share one clock. Rewriting the picture
    # timestamps to N/FR/TB restarted them at zero while the copied sound kept
    # the broadcast timestamps, so a capture running for hours ended up with
    # the sound tens of thousands of seconds away and its AAC undecodable.
    # Keep both on the broadcast clock and let the muxer move them together.
    FC="[0:v]bwdif=mode=send_frame,format=nv12[enc];[enc]split=2[main][an]"
    FC="$FC;[an]${analyze}[aux]"
    VIDEO_IN="-filter_complex $FC -map [main]"
    # The analysis branch ends in the null muxer; without an explicit encoder
    # ffmpeg reuses the v4l2m2m one from the main stream and fails.
    # Runs to completion on its own output; the recording output follows.
    FEAT_AUX_OUT="-map [aux] -c:v rawvideo -f null /dev/null"
    # Audio RMS is a third output of the same stage. Codec copy cannot be
    # filtered, so the analysis copies decode to PCM.
    FEAT_AUDIO_OUT="-map 0:a:0 -c:a pcm_s16le -ar 48000 -ac 2 -af astats=metadata=1:reset=1:measure_perchannel=none:measure_overall=RMS_level+Number_of_samples,ametadata=mode=print:file=/dev/shm/pix/feat-a.log -f null /dev/null"
    FEAT_ARGS="--feature-file $PIX_LOG_DIR/pix-ff1.log --feature-audio-file /dev/shm/pix/feat-a.log"
    FEAT_ARGS="$FEAT_ARGS --feature-black-file $PIX_LOG_DIR/pix-ff1.log --feature-max-mb $PIX_FEATURE_MAX_MB"
fi

log "tuner=$DEV channel=$PIX_CHANNEL port=$PIX_PORT bitrate=$PIX_BITRATE"

# 1 段目: TS -> H.264 + AAC の TS（SPS/PPS を帯域内に持つ）
# 2 段目: TS -> fMP4（SPS/PPS から正しい avcC を作る）
#
# 起動直後は前のプロセスがデバイスやソケットを握っていることがあり、一度で
# 立ち上がらない場合がある。落ちたら少し待って組み直す。
# The tuner decides how the transport stream is produced and whether a
# separate B-CAS step is needed:
#   pxs1ud  PX-S1UD delivers a scrambled multiplex; torne-b25 descrambles it.
#   torne   torne-c delivers a scrambled multiplex; torne-b25 descrambles it.
#   dt295   pix-ts-legacy descrambles inside the tuner path, so nothing else
#           may touch the stream.
ts_source() {
    sleep "$PIX_START_DELAY"

    case "$PIX_TUNER" in
        torne)
            torne-c --channel "$PIX_CHANNEL" 2>"$PIX_LOG_DIR/pix-ts.log" \
              | torne-b25 --card-socket "$PIX_CARD_SOCKET" 2>"$PIX_LOG_DIR/pix-b25.log"
            ;;
        dt295)
            # Terrestrial channels are written T<number>; satellite channels
            # use the plain number plus a slot or TSID, which the tuner needs
            # to pick one transponder out of the band.
            case "$PIX_SYSTEM" in
                terrestrial) chan="T$PIX_CHANNEL" ;;
                *)           chan="$PIX_CHANNEL" ;;
            esac
            extra=""
            [ -n "$PIX_SAT_SLOT" ] && extra="$extra --slot $PIX_SAT_SLOT"
            [ -n "$PIX_SAT_TSID" ] && extra="$extra --tsid $PIX_SAT_TSID"
            # A satellite transponder carries several services. Without a PID
            # filter the multiplex mixes their streams and the encoder sees a
            # picture and a sound that do not belong together.
            for pid in $PIX_PIDS; do
                extra="$extra -p $pid"
            done
            # The tuner hands over the multiplex still scrambled, so the same
            # B-CAS step as the other tuners is needed here. Set
            # PIX_DT295_DESCRAMBLED=1 only if a build is known to clear it.
            # shellcheck disable=SC2086
            if [ "$PIX_DT295_DESCRAMBLED" = "1" ]; then
                pix-ts-legacy --model dt295 --assets "$PIX_DT295_ASSETS" \
                    -s "$PIX_SYSTEM" -c "$chan" $extra 2>"$PIX_LOG_DIR/pix-ts.log"
            else
                # --trace is not optional here: without it torne-b25 fails the
                # card exchange on a live stream and the chain dies at once.
                # The tuner's first bytes are not always packet aligned, and
                # arib25 rejects such a stream outright (status -3). A copy
                # through ffmpeg resynchronises it before the descrambler.
                # Without -t the tuner leaves the descrambler's card exchange
                # failing (measured: no -t fails, -t succeeds three times out
                # of three). Capture in chunks instead and let the loop start
                # the next one; the gap lands on a programme boundary.
                pix-ts-legacy --model dt295 --assets "$PIX_DT295_ASSETS" \
                    -s "$PIX_SYSTEM" -c "$chan" $extra \
                    -t "$PIX_CAPTURE_SECONDS" 2>"$PIX_LOG_DIR/pix-ts.log" \
                  | ffmpeg -hide_banner -nostdin -v error -f mpegts \
                        -probesize 2000000 -analyzeduration 3000000 -i pipe:0 \
                        -map 0 -c copy -f mpegts pipe:1 2>"$PIX_LOG_DIR/pix-resync.log" \
                  | torne-b25 --card-socket "$PIX_CARD_SOCKET" \
                        --trace /dev/shm/pix/b25.trace 2>"$PIX_LOG_DIR/pix-b25.log"
            fi
            ;;
        pxs1ud|*)
            siano-ts --device "$DEV" --firmware "$PIX_FIRMWARE" -c "$PIX_CHANNEL" \
                2>"$PIX_LOG_DIR/pix-ts.log" \
              | torne-b25 --card-socket "$PIX_CARD_SOCKET" 2>"$PIX_LOG_DIR/pix-b25.log"
            ;;
    esac
}

# The card exchange fails now and then before it ever answers, and when it
# fails torne-b25 exits without a byte. Retry until the tuner's stream is
# actually decrypted, then hand the file on: the encoder never sees the
# attempts, only a stream that already has data at its head.
start_live() {
    attempt=1
    while [ "$attempt" -le "$PIX_LIVE_TRIES" ]; do
        rm -f "$PIX_LIVE_FILE"
        ts_source >"$PIX_LIVE_FILE" 2>"$PIX_LOG_DIR/pix-producer.log" &
        live_pid=$!
        waited=0
        while [ "$waited" -lt 40 ]; do
            [ -s "$PIX_LIVE_FILE" ] && return 0
            sleep 0.5
            waited=$((waited + 1))
        done
        kill -TERM "$live_pid" 2>/dev/null
        wait "$live_pid" 2>/dev/null
        log "no decrypted data on attempt ${attempt}/${PIX_LIVE_TRIES}"
        attempt=$((attempt + 1))
    done
    live_pid=""
    return 1
}

dt295_port_reset() {
    # Find the tuner's port, then reset only that one: the root filesystem is
    # on the other USB port and resetting it would take the system down.
    for child in /sys/bus/usb/devices/*; do
        [ -r "$child/idVendor" ] || continue
        [ "$(cat "$child/idVendor")" = "06b8" ] || continue
        [ "$(cat "$child/idProduct")" = "103b" ] || continue
        dev=$(basename "$child")
        break
    done
    case "$dev" in
        *-*) bus=${dev%%-*}; port=${dev#*-}; port=${port%%.*} ;;
        *) log "DT295 device path unknown"; return ;;
    esac
    node=/sys/bus/usb/devices/usb${bus}/${bus}-0:1.0/usb${bus}-port${port}/disable
    [ -w "$node" ] || { log "no reset node for $dev"; return; }
    log "resetting the DT295 port ($dev)"
    echo 1 > "$node" 2>/dev/null
    sleep 2
    echo 0 > "$node" 2>/dev/null
    sleep 4
}

run_pipeline() {
    # 復号器の出力を直接エンコーダへ繋ぐと、エンコーダの初期化中に復号器が
    # 書き込みで止まり、カードのやり取りが途切れて落ちる。ファイルを挟むと
    # 復号器は止まらずに書き続けられる（実測で確認）。
    rm -f "$PIX_LIVE_FILE"
    # スクリプト経由だと復号器が起動直後に落ちるため、実績のある形をそのまま
    # ここへ書く（チューナー → 再同期 → 復号）。
    case "$PIX_SYSTEM" in
        terrestrial) live_chan="T$PIX_CHANNEL" ;;
        *)           live_chan="$PIX_CHANNEL" ;;
    esac
    live_extra=""
    [ -n "$PIX_SAT_SLOT" ] && live_extra="$live_extra --slot $PIX_SAT_SLOT"
    for pid in $PIX_PIDS; do live_extra="$live_extra -p $pid"; done
    (
        # shellcheck disable=SC2086
        pix-ts-legacy --model dt295 --assets "$PIX_DT295_ASSETS" \
            -s "$PIX_SYSTEM" -c "$live_chan" $live_extra -t "$PIX_CAPTURE_SECONDS" \
            2>"$PIX_LOG_DIR/pix-ts.log" \
          | ffmpeg -hide_banner -nostdin -v error -f mpegts \
                -probesize 2000000 -analyzeduration 3000000 -i pipe:0 \
                -map 0 -c copy -f mpegts pipe:1 2>"$PIX_LOG_DIR/pix-resync.log" \
          | torne-b25 --card-socket "$PIX_CARD_SOCKET" \
                --trace /dev/shm/pix/b25.trace 2>"$PIX_LOG_DIR/pix-b25.log"
    ) > "$PIX_LIVE_FILE" 2>"$PIX_LOG_DIR/pix-source.log" &
    producer=$!
    waited=0
    while [ "$waited" -lt 40 ]; do
        [ -s "$PIX_LIVE_FILE" ] && break
        sleep 0.5
        waited=$((waited + 1))
    done
    if [ ! -s "$PIX_LIVE_FILE" ]; then
        log "no decrypted data; restarting"
        kill -TERM "$producer" 2>/dev/null
        wait "$producer" 2>/dev/null
        return 1
    fi
    # ファイルは tmpfs に置くので、上限を超えたら区切って作り直す。
    (
        while :; do
            sleep 10
            size=$(stat -c %s "$PIX_LIVE_FILE" 2>/dev/null || echo 0)
            [ "$size" -gt $((PIX_LIVE_MAX_MB * 1024 * 1024)) ] || continue
            log "live buffer reached ${PIX_LIVE_MAX_MB}MB; starting a new one"
            kill -TERM "$producer" 2>/dev/null
            for p in $(ps | grep -E "[t]ail -f" | awk '{print $1}'); do
                kill -TERM "$p" 2>/dev/null
            done
            break
        done
    ) &
    watchdog=$!
    tail -f -c +1 "$PIX_LIVE_FILE" 2>/dev/null \
      | ffmpeg -hide_banner -nostdin -v info -nostats -probesize 2000000 -analyzeduration 3000000 -f mpegts -i pipe:0 \
          -c:v mpeg2_v4l2m2m $VIDEO_IN \
          -c:v h264_v4l2m2m -num_capture_buffers 32 -b:v "$PIX_BITRATE" -g "$PIX_GOP" \
          -map 0:v:0 -map 0:a:0 -c:a copy -copyts -start_at_zero -f mpegts pipe:1 \
          $FEAT_AUX_OUT $FEAT_AUDIO_OUT 2>"$PIX_LOG_DIR/pix-ff1.log" \
      | ffmpeg -hide_banner -nostdin -v info -nostats -probesize 2000000 -analyzeduration 3000000 \
          -f mpegts -i pipe:0 \
          -map 0:v -map 0:a -c copy -bsf:a aac_adtstoasc \
          -movflags +frag_keyframe+empty_moov+default_base_moof -f mp4 pipe:1 \
          2>"$PIX_LOG_DIR/pix-ff2.log" \
      | stb_streamer --port "$PIX_PORT" --allowed-ip "$PIX_ALLOWED_IP" \
          --spool-mb "$PIX_SPOOL_MB" --channel "$PIX_CHANNEL" --display "$PIX_DISPLAY" \
          --program-file /dev/shm/pix/program.txt $FEAT_ARGS \
          2>"$PIX_LOG_DIR/pix-stb.log"
    kill -TERM "$watchdog" 2>/dev/null
    kill -TERM "$producer" 2>/dev/null
    wait "$producer" 2>/dev/null
}

feature_failures=0
short_runs=0
while :; do
    # A failed run leaves its stages behind. Without clearing them the next
    # attempt starts a second tuner on the same USB device, which then reads
    # nothing and drags the whole chain down with it.
    kill_stale
    # Start each attempt with an empty tuner log: the off-air check below
    # reads it, and a message left over from an earlier attempt would make a
    # live channel look like it is still off the air.
    : > "$PIX_LOG_DIR/pix-ts.log"
    # The DT295 only streams reliably after a fresh USB enumeration. Starting
    # the tuner again on the same enumeration is what turned every retry into
    # another failure, so the port is reset before each attempt.
    if [ "$PIX_TUNER" = "dt295" ]; then
        dt295_port_reset
    fi
    started=$(date +%s)
    run_pipeline
    ended=$(date +%s)
    if [ "$g_stop" = "1" ]; then
        break
    fi
    ran=$((ended - started))
    log "pipeline stopped after ${ran}s; restarting"
    # A channel that is not broadcasting answers with an empty PAT. Retrying
    # every few seconds then only hammers the tuner; wait for the station to
    # come back instead.
    if grep -q "PAT contains no programs" "$PIX_LOG_DIR/pix-ts.log" 2>/dev/null; then
        log "the channel is not broadcasting; waiting before the next try"
        sleep "${PIX_OFFAIR_WAIT:-300}"
    fi
    # A short life means the analysis chain or the tuner is failing. After
    # several in a row, drop the analysis and run the plain pipeline: the
    # recording matters more than the feature sideband.
    if [ "$ran" -lt 30 ]; then
        feature_failures=$((feature_failures + 1))
    else
        feature_failures=0
    fi
    # A tuner that keeps failing is not helped by another start: the DT295
    # leaves its firmware in a state only a replug clears, so stop instead of
    # hammering it and say so in the log.
    if [ "$ran" -lt 30 ]; then
        short_runs=$((short_runs + 1))
    else
        short_runs=0
    fi
    if [ "$short_runs" -ge "${PIX_MAX_SHORT_RUNS:-12}" ]; then
        log "pipeline failed ${short_runs} times in a row; stopping (check the tuner)"
        break
    fi
    if [ "$PIX_FEATURES" = "1" ] && [ "$feature_failures" -ge "$PIX_FEATURE_FAILURES" ]; then
        log "analysis failed ${feature_failures} times; disabling features for this run"
        PIX_FEATURES=0
        FEAT_ARGS=""
        FEAT_AUX_OUT=""
        FEAT_AUDIO_OUT=""
        VIDEO_IN="-vf $VF"
    fi
    sleep 5
done
