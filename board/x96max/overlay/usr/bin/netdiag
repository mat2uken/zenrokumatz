#!/bin/sh
# Record the network state at boot so a unit that cannot be reached over the
# network still reports why. Written to /dev/shm so it survives on RAM.
{
    echo "=== netdiag $(date) ==="
    ip -4 addr show 2>&1
    ip link show eth0 2>&1
    echo "carrier: $(cat /sys/class/net/eth0/carrier 2>&1)"
    echo "operstate: $(cat /sys/class/net/eth0/operstate 2>&1)"
    dmesg | grep -i "dwmac\|eth0\|PHY" | tail -8
    echo "=== udhcpc log ==="
    tail -5 /tmp/udhcpc.log 2>/dev/null
} > /dev/shm/netdiag.txt 2>&1
