#!/bin/sh
#
# pix-logo-weekly - 週に1回、深夜に局ロゴを取りに行く
#
# BS の局ロゴ (929) はチューナーを借りる必要があるので、録画を数分止める。
# 放送が少ない深夜に週 1 回だけ実行する。時刻は /etc/default/pix-stream-linux の
# PIX_LOGO_WEEKLY_DAY (1=月 .. 7=日) と PIX_LOGO_WEEKLY_HOUR (0-23) で決める。
#
# 端末に RTC が無く、起動直後は時計が 1970 年を指す。時計が正しくないあいだは
# 何もしない。1 週間のうちに指定の時刻帯へ入ったら 1 回だけ実行し、成否を
# /var/lib/pix/logos/.weekly に残す (同じ週に何度も止めない)。
set -u

# 端末はUTCで動いている。放送も人間の予定も日本時間なので、ここだけJSTで数える
# (busybox の date は TZ を見る)。
TZ=${PIX_LOGO_TZ:-JST-9}
export TZ

DEFAULTS=/etc/default/pix-stream-linux
LOG=${PIX_LOGO_LOG:-/tmp/pix-logo.log}
STATE=${PIX_LOGO_DIR:-/var/lib/pix/logos}/.weekly
FETCH=${PIX_LOGO_FETCH:-/usr/bin/pix-logo-fetch}
OWNER=/var/run/pix-logo-weekly.owner
STOPFILE=/var/run/pix-logo.stopped
child=""
# 2025 年より前は時計が合っていないとみなす (RTC が無いので起動直後は 1970)。
CLOCK_MIN=1735689600
# 最小の待ち受け回数。時計が飛んでも指定の時刻帯でだけ走る。
SLEEP_SECONDS=${PIX_LOGO_WEEKLY_POLL:-300}

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') pix-logo-weekly: $*" | tee -a "$LOG" >&2; }

# 環境変数で渡された値は設定ファイルより優先する (試運転しやすくするため)。
day_override=${PIX_LOGO_WEEKLY_DAY:-}
hour_override=${PIX_LOGO_WEEKLY_HOUR:-}
wait_override=${PIX_LOGO_WEEKLY_WAIT:-}
[ -r "$DEFAULTS" ] && . "$DEFAULTS" 2>/dev/null || true
day=${day_override:-${PIX_LOGO_WEEKLY_DAY:-1}}
hour=${hour_override:-${PIX_LOGO_WEEKLY_HOUR:-4}}
wait_seconds=${wait_override:-${PIX_LOGO_WEEKLY_WAIT:-900}}

if [ "${PIX_LOGO_WEEKLY:-1}" != "1" ]; then
    log "weekly fetch is disabled (PIX_LOGO_WEEKLY=$PIX_LOGO_WEEKLY)"
fi
if [ ! -x "$FETCH" ]; then
    log "$FETCH is missing; nothing to schedule"
fi

# Keep the child asynchronous so TERM interrupts wait, rather than being
# deferred until a foreground fetch (up to 900s) or 6-hour sleep completes.
run_child() {
    [ ! -e "$STOPFILE" ] || return 1
    "$@" &
    child=$!
    wait "$child"
    child_status=$?
    child=""
    return "$child_status"
}
cleanup() {
    status=$?
    trap - EXIT
    trap '' INT TERM
    failed=0
    if [ -n "$child" ]; then
        kill -TERM "$child" 2>/dev/null || true
        waited=0
        while kill -0 "$child" 2>/dev/null && [ "$waited" -lt 45 ]; do
            sleep 1
            waited=$((waited + 1))
        done
        if kill -0 "$child" 2>/dev/null; then
            kill -KILL "$child" 2>/dev/null || true
            failed=1
        else
            wait "$child" 2>/dev/null
            child_status=$?
            log "child exited with status $child_status (fetch lock governs tuner exclusion)"
        fi
    fi
    if [ "$failed" = 0 ]; then
        rm -f "$OWNER/pid"
        rmdir "$OWNER" || status=1
    else
        log "child teardown failed; retaining ownership"
        status=1
    fi
    exit "$status"
}
[ ! -e "$STOPFILE" ] || exit 1
mkdir "$OWNER" 2>/dev/null || { log 'scheduler already owned'; exit 1; }
trap cleanup EXIT
trap 'exit 143' INT TERM
echo "$$" > "$OWNER/pid" || exit 1

log "scheduled for weekday $day at ${hour}時台 (wait ${wait_seconds}s), poll ${SLEEP_SECONDS}s"
tuner_warned=0

while [ ! -e "$STOPFILE" ]; do
    now=$(date +%s 2>/dev/null || echo 0)
    if [ "$now" -lt "$CLOCK_MIN" ]; then
        run_child sleep "$SLEEP_SECONDS"
        continue
    fi
    if [ "${PIX_LOGO_WEEKLY:-1}" != "1" ] || [ ! -x "$FETCH" ]; then
        run_child sleep "$SLEEP_SECONDS"
        continue
    fi
    # BS-15 の局ロゴは dt295 系のチューナーでしか取れない。取れない機体で
    # 毎週失敗し続けても意味がないので、設定を見て止める (ログは 1 回だけ)。
    if [ "${PIX_TUNER:-}" != "dt295" ]; then
        if [ "$tuner_warned" = 0 ]; then
            log "PIX_TUNER is '${PIX_TUNER:-}'; BS-15 logos need dt295, weekly fetch disabled"
            tuner_warned=1
        fi
        run_child sleep "$SLEEP_SECONDS"
        continue
    fi
    week=$(date +%G-%V)
    done_week=$(sed -n 's/^week=//p' "$STATE" 2>/dev/null)
    today=$(date +%u)
    this_hour=$(date +%H)
    if [ "$done_week" != "$week" ] && [ "$today" = "$day" ] &&
       [ "$(expr "$this_hour" + 0)" = "$(expr "$hour" + 0)" ]; then
        log "starting the weekly logo fetch (week $week)"
        started=$(date +%s)
        run_child "$FETCH" --force --wait "$wait_seconds"
        status=$?
        elapsed=$(( $(date +%s) - started ))
        mkdir -p "${PIX_LOGO_DIR:-/var/lib/pix/logos}"
        {
            echo "week=$week"
            echo "status=$status"
            echo "seconds=$elapsed"
            echo "at=$(date '+%Y-%m-%dT%H:%M:%S%z')"
        } > "${STATE}.tmp" && mv "${STATE}.tmp" "$STATE"
        case "$status" in
            0) log "weekly fetch done in ${elapsed}s" ;;
            3) log "no logo data this week (${elapsed}s); next week" ;;
            *) log "weekly fetch failed (exit $status); retrying in 6 hours" ;;
        esac
        if [ "$status" != "0" ] && [ "$status" != "3" ]; then
            # 失敗した週は 6 時間後に 1 度だけやり直す (録画への影響を抑えるため
            # 同じ週に何度も止めない: done_week を書かないので条件は満たすが、
            # 時刻帯を外れると走らない)。
            run_child sleep 21600
            continue
        fi
    fi
    run_child sleep "$SLEEP_SECONDS"
done
