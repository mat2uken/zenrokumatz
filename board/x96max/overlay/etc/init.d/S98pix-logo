#!/bin/sh
# 週 1 回の局ロゴ取得を常駐させる。S97pix-stream より後ろで、録画とは独立に動く。
DAEMON=/usr/bin/pix-logo-weekly
PIDFILE=/var/run/pix-logo-weekly.pid

start() {
    printf 'Starting pix-logo-weekly: '
    mkdir -p /var/lib/pix/logos
    if [ -f "$PIDFILE" ]; then
        pid=$(cat "$PIDFILE" 2>/dev/null)
        if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$PIDFILE"
        fi
    fi
    # The daemon outlives this script; keep it off the caller's stdout so a
    # start over ssh does not hang on a pipe the daemon still holds.
    start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON" \
        </dev/null >>/tmp/pix-logo-weekly.out 2>&1 && echo "OK" || echo "FAIL"
}

stop() {
    printf 'Stopping pix-logo-weekly: '
    start-stop-daemon -K -q -p "$PIDFILE" -R TERM/5/KILL/5 && echo "OK" || echo "not running"
    rm -f "$PIDFILE"
}

case "$1" in
    start|stop) "$1";;
    restart) stop; sleep 1; start;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1;;
esac
